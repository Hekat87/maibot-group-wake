{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "没叫你别说话",
  "description": "指定群平时完全静默（不主动说话），只有被 @ 时短暂唤醒；窗口时长可配置。",
  "author": {
    "name": "dsh",
    "url": "https://github.com/Hekat87"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Hekat87/maibot-group-wake",
    "homepage": "https://github.com/Hekat87/maibot-group-wake",
    "documentation": "https://github.com/Hekat87/maibot-group-wake/blob/main/README.md",
    "issues": "https://github.com/Hekat87/maibot-group-wake/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "bell",
      "background": "#1C272C"
    }
  },
  "capabilities": [
    "frequency.set_adjust",
    "frequency.get_current_talk_value"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.hekat87.group-wake"
}
